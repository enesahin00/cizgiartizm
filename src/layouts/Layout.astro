---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { langs, routes, ui, type Alternates, type Lang, type RouteKey } from "../i18n";

interface Props {
  lang?: Lang;
  /** Sabit sayfalar: dil karşılığı routes tablosundan gelir. */
  route?: RouteKey;
  /** Blog yazısı gibi dinamik sayfalar: karşılıkları doğrudan verilir. */
  alternates?: Alternates;
  title?: string;
  description?: string;
  image?: string;
}

const { lang = "tr", route, alternates } = Astro.props;
const t = ui[lang];
const {
  title = t.defaultTitle,
  description = t.defaultDescription,
  image = "/images/zeus-poseidon-bina-cephesi-grafitti.jpg",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

// Paylaşım görseli (WhatsApp, Facebook, X): public/images'taki orijinaller 2 MB'a
// kadar çıkıyor. Aynı adlı src/assets görselinden en fazla 1200px genişlikte JPEG
// üretilir (küçük görsel büyütülmez); assets'te karşılığı yoksa yol aynen kullanılır.
const ogAssets = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/*.{png,jpeg,jpg}",
  { eager: true }
);
const ogAsset = ogAssets[`/src/assets/images/${image.split("/").pop()}`]?.default;
const ogWidth = ogAsset ? Math.min(1200, ogAsset.width) : undefined;
const ogHeight = ogAsset && ogWidth ? Math.round((ogWidth * ogAsset.height) / ogAsset.width) : undefined;
const ogImage = ogAsset
  ? (await getImage({ src: ogAsset, width: ogWidth, format: "jpeg", quality: 80 })).src
  : image;
const ogImageUrl = new URL(ogImage, Astro.site).toString();

// Çevirisi olan sayfalarda hreflang; dil kutucukları çevirisi olmayan dilde o
// dilin ana sayfasına gider.
const translations: Alternates = alternates ?? (route ? routes[route] : {});
const langLinks = Object.fromEntries(
  langs.map((l) => [l, translations[l] ?? routes.home[l]])
) as Record<Lang, string>;
const absolute = (path: string) => new URL(path.endsWith("/") ? path : `${path}/`, Astro.site);
const hreflangs = langs.every((l) => translations[l])
  ? langs.map((l) => ({ hreflang: ui[l].htmlLang, href: absolute(translations[l]!) }))
  : [];
// x-default: hiçbir sürümle eşleşmeyen dilde İngilizce (otomatik dil kuralıyla aynı:
// dili desteklenmeyen Türkiye dışı ziyaretçi İngilizce görür).
const xDefault = hreflangs.find((h) => h.hreflang === ui.en.htmlLang);
// Otomatik dil yönlendirmesinin hedefleri: öbür dillerdeki karşılıklar
// (data-alt-<dil>). Sondaki "/" ile, yoksa GitHub Pages bir 301 daha ekler.
const langAlts = Object.fromEntries(
  hreflangs.length > 0
    ? langs.filter((l) => l !== lang).map((l) => [`data-alt-${l}`, absolute(translations[l]!).pathname])
    : []
);
---

<!doctype html>
<html lang={t.htmlLang} dir={t.dir} {...langAlts}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Varsayılan dil: dışarıdan gelen ziyaretçi, cihaz saat dilimi Türkiye ise
         Türkçe sürüme yönlenir. Türkiye dışında tarayıcı dil listesindeki
         (navigator.languages) desteklenen ilk dil açılır, hiçbiri desteklenmiyorsa
         İngilizce. Ağ isteği yok; parse'tan önce, Google etiketinden önce çalışır.
         Türkiye içinde tarayıcı diline bakılmaz: İngilizce arayüzlü Türk cihazı da
         Türkçe görsün. Kurallar:
         - botlar ve otomasyon yönlendirilmez (Google Türkçe sayfaları görmeye devam etsin)
         - reklam tıklaması (gclid/gbraid/wbraid/msclkid/utm_*) ve arama motorundan gelen
           yönlendirilmez: reklamın hedef sayfası ve Google'ın hreflang ile seçtiği sonuç
           ziyaretçinin dilidir (İstanbul'daki cihaza İngilizce reklam, Dubai'deki cihaza
           Arapça reklam olduğu gibi açılır)
         - otomatik karar yalnız TR/EN sayfalarında verilir; ES/AR sayfasına doğrudan
           gelen (paylaşılan bağlantı) kalır
         - site içi gezinmede yönlendirme yok; dil kutucuğuyla geçiş seçim olarak saklanır
           ve sonraki girişlerde saat diliminin önüne geçer (seçilen dil ES/AR olabilir).
           Otomatik yönlendirmenin vardığı sayfa da site içinden gelmiş görünür; o sayfa
           langAuto ile tanınır, seçim olarak saklanmaz
         - oturum başına en fazla bir yönlendirme (depolama kapalıysa kullanıcı kilitlenmesin)
         - sorgu ve hash korunur (Google Ads gclid kaybolmasın)
         Dil önekleri src/i18n langs ile aynı olmalı: /en/, /es/, /ar/ -->
    <script is:inline>
      (function () {
        var html = document.documentElement, lang = html.lang;
        if (navigator.webdriver || /bot|crawl|spider|slurp|google|bing|yandex|baidu|lighthouse|headless|preview/i.test(navigator.userAgent)) return;
        function get(s, k) { try { return window[s].getItem(k); } catch (e) { return null; } }
        function set(s, k, v) { try { window[s].setItem(k, v); } catch (e) {} }
        try {
          if (get("sessionStorage", "langAuto") === location.pathname) {
            set("sessionStorage", "langAuto", "");
            return;
          }
          var ref = document.referrer ? new URL(document.referrer) : null;
          if (ref && ref.origin === location.origin) {
            var from = ref.pathname.match(/^\/(en|es|ar)(\/|$)/);
            if ((from ? from[1] : "tr") !== lang) set("localStorage", "lang", lang);
            return;
          }
          if (/[?&](gclid|gbraid|wbraid|msclkid|utm_[a-z]+)=/i.test(location.search)) return;
          if (ref && /(^|\.)(google|bing|yahoo|yandex|duckduckgo|baidu|ecosia|naver|seznam|qwant)\./i.test(ref.hostname)) return;
          if (get("sessionStorage", "langRedirected")) return;
          var want = get("localStorage", "lang");
          if (!want) {
            if (lang !== "tr" && lang !== "en") return;
            var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
            if (!tz) return;
            if (/^(Europe|Asia)\/Istanbul$|^Turkey$/.test(tz)) want = "tr";
            else {
              want = "en";
              var prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language];
              for (var i = 0; i < prefs.length; i++) {
                var m = /^(tr|en|es|ar)(-|$)/i.exec(prefs[i] || "");
                if (m) { want = m[1].toLowerCase(); break; }
              }
            }
          }
          var alt = want !== lang && html.getAttribute("data-alt-" + want);
          if (alt) {
            set("sessionStorage", "langRedirected", "1");
            set("sessionStorage", "langAuto", alt);
            window.__langRedirect = true;
            location.replace(alt + location.search + location.hash);
          }
        } catch (e) {}
      })();
    </script>
    <!-- Reveal stilleri yalnız JS varken devreye girsin (no-JS'te her şey görünür) -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <!-- Google etiketi (GA4 + Google Ads) — eski WordPress sitesindeki kimliklerle aynı,
         reklam dönüşüm takibi kopmasın. İzinli alan adları astro.config.mjs CSP'de.
         Dil yönlendirmesi başladıysa bu sayfa için görüntüleme gönderilmez (çift sayım). -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-7N3EN1HBTS"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      if (!window.__langRedirect) {
        gtag("js", new Date());
        gtag("config", "G-7N3EN1HBTS");
        gtag("config", "AW-16646268606");
      }
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {hreflangs.map((h) => <link rel="alternate" hreflang={h.hreflang} href={h.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault.href} />}
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    {ogWidth && <meta property="og:image:width" content={String(ogWidth)} />}
    {ogHeight && <meta property="og:image:height" content={String(ogHeight)} />}
    <meta property="og:locale" content={t.ogLocale} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ui[l].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- LocalBusiness yapısal verisi -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": new URL("/#business", Astro.site).toString(),
      "name": "Çizgi Artizm",
      "description": description,
      "image": ogImageUrl,
      "url": new URL("/", Astro.site).toString(),
      "telephone": ["+905396183767", "+905357746012"],
      "email": "cizgiartizm@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "TR",
      },
      "priceRange": "₺₺",
      "knowsAbout": t.knowsAbout,
      "sameAs": ["https://www.instagram.com/cizgiartizm/"],
    })} />

    <slot name="head" />
  </head>
  <body>
    <Header lang={lang} langLinks={langLinks} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- Yüzen WhatsApp butonu -->
    <a
      href="https://wa.me/905396183767"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={t.whatsapp}
      data-track-location="floating"
      class="fixed bottom-5 end-5 z-[90] flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg ring-1 ring-black/5 transition-transform hover:scale-110"
    >
      <span
        aria-hidden="true"
        class="absolute inset-0 -z-10 rounded-full bg-[#25D366] opacity-40 motion-safe:animate-ping [animation-duration:2.4s]"
      ></span>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.668-.961zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
    </a>

    <script>
      import "../scripts/click-tracking";
      import "../scripts/clarity";

      // Scroll-reveal: görünüme girince .is-revealed ekle, sonra izlemeyi bırak.
      const revealEls = document.querySelectorAll("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-revealed");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add("is-revealed"));
      }

      // Lazy görseller: yüklenince fade-in
      document.querySelectorAll<HTMLImageElement>("img[data-fade]").forEach((img) => {
        if (img.complete) img.classList.add("is-loaded");
        else img.addEventListener("load", () => img.classList.add("is-loaded"), { once: true });
      });
    </script>
  </body>
</html>
