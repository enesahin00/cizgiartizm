---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import headerBg from "../assets/images/frida-kahlo-portre-ic-mekan-duvar-resmi.jpg";

const contacts = [
  {
    label: "Telefon",
    value: "0539 618 37 67",
    href: "tel:+905396183767",
    icon: "phone",
  },
  {
    label: "Telefon",
    value: "0535 774 60 12",
    href: "tel:+905357746012",
    icon: "phone",
  },
  {
    label: "WhatsApp",
    value: "Mesaj gönderin",
    href: "https://wa.me/905396183767",
    icon: "whatsapp",
  },
  {
    label: "E-posta",
    value: "cizgiartizm@gmail.com",
    href: "mailto:cizgiartizm@gmail.com",
    icon: "mail",
  },
  {
    label: "Instagram",
    value: "@cizgiartizm",
    href: "https://instagram.com/cizgiartizm",
    icon: "instagram",
  },
];
---

<Layout
  title="İletişim — Çizgi Artizm"
  description="Aklınıza takılan her şeyi bize sorabilirsiniz. Telefon, WhatsApp, e-posta veya Instagram üzerinden Çizgi Artizm ile iletişime geçin."
>
  <section class="relative isolate overflow-hidden border-b border-neutral-800 bg-neutral-950 py-16 text-white">
    <Image src={headerBg} alt="" aria-hidden="true" loading="eager" class="absolute inset-0 -z-10 h-full w-full object-cover object-center opacity-50" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-neutral-950 via-neutral-950/80 to-neutral-950/30"></div>
    <div class="mx-auto max-w-6xl px-5">
      <p class="text-sm font-semibold uppercase tracking-widest text-neutral-400">İletişim</p>
      <h1 class="mt-3 font-display text-4xl md:text-6xl drop-shadow">Merhaba 👋</h1>
      <p class="mt-4 max-w-xl text-lg text-neutral-300 drop-shadow">
        Bir fikriniz, bir sorunuz ya da sadece merak ettiğiniz bir şey mi var?
        Aklınıza takılan her şeyi çekinmeden sorabilirsiniz — en kısa sürede
        size dönelim.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 lg:grid-cols-2">
      <!-- İletişim yöntemleri -->
      <div>
        <h2 class="font-display text-2xl text-neutral-900">Bize ulaşın</h2>
        <p class="mt-2 text-neutral-600">Size en uygun yöntemi seçin.</p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {contacts.map((c, i) => (
            <a
              href={c.href}
              class:list={[
                "group flex items-center gap-4 rounded-2xl border border-neutral-200 p-5 transition-colors hover:border-neutral-900",
                contacts.length % 2 !== 0 && i === contacts.length - 1
                  ? "sm:col-span-2 sm:max-w-[calc(50%-8px)]"
                  : "",
              ]}
            >
              <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-neutral-900 text-white transition-transform group-hover:scale-105">
                {c.icon === "phone" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                )}
                {c.icon === "whatsapp" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.668-.961zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                )}
                {c.icon === "mail" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
                )}
                {c.icon === "instagram" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                )}
              </span>
              <span class="min-w-0">
                <span class="block text-xs font-semibold uppercase tracking-wider text-neutral-500">{c.label}</span>
                <span class="block truncate font-semibold text-neutral-900">{c.value}</span>
              </span>
            </a>
          ))}
        </div>

        <p class="mt-8 text-sm text-neutral-500">
          <span class="font-semibold text-neutral-700">Hizmet bölgeleri:</span>
          İstanbul, Ankara, İzmir, Bursa ve Türkiye geneli.
        </p>
      </div>

      <!-- Form -->
      <div class="rounded-3xl bg-neutral-50 p-8 ring-1 ring-neutral-200">
        <h2 class="font-display text-2xl text-neutral-900">Bize yazın</h2>
        <p class="mt-2 text-sm text-neutral-600">
          Formu doldurun, "Gönder"e basınca e-posta uygulamanız hazır mesajla açılır;
          size en kısa sürede dönelim.
        </p>

        <form id="contact-form" class="mt-6 space-y-4">
          <div>
            <label for="ad" class="block text-sm font-medium text-neutral-700">Adınız</label>
            <input id="ad" name="ad" type="text" required class="mt-1 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm focus:border-neutral-900 focus:outline-none focus:ring-2 focus:ring-neutral-900/10" />
          </div>
          <div>
            <label for="eposta" class="block text-sm font-medium text-neutral-700">E-posta</label>
            <input id="eposta" name="eposta" type="email" required class="mt-1 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm focus:border-neutral-900 focus:outline-none focus:ring-2 focus:ring-neutral-900/10" />
          </div>
          <div>
            <label for="mesaj" class="block text-sm font-medium text-neutral-700">Mesajınız</label>
            <textarea id="mesaj" name="mesaj" rows="4" required class="mt-1 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm focus:border-neutral-900 focus:outline-none focus:ring-2 focus:ring-neutral-900/10"></textarea>
          </div>
          <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-full bg-neutral-900 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-neutral-700">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
            E-posta ile Gönder
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const get = (id: string) =>
      (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value.trim() ?? "";

    const ad = get("ad");
    const eposta = get("eposta");
    const mesaj = get("mesaj");

    const konu = `Web sitesi mesajı — ${ad}`;
    const govde = `Ad: ${ad}\nE-posta: ${eposta}\n\n${mesaj}`;

    window.location.href = `mailto:cizgiartizm@gmail.com?subject=${encodeURIComponent(konu)}&body=${encodeURIComponent(govde)}`;
  });
</script>
