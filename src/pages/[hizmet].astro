---
import ServiceLanding from "../views/ServiceLanding.astro";
import { getLandings, type Landing } from "../i18n/landings";

export function getStaticPaths() {
  return getLandings("tr").map((landing) => ({ params: { hizmet: landing.slug }, props: { landing } }));
}

const { landing } = Astro.props as { landing: Landing };
---

<ServiceLanding landing={landing} />
