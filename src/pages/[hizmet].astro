---
// Hizmet açılış sayfası şablonu. İçerik src/data/serviceLandings.ts'te;
// her kayıt kökte kendi adresini alır (/okul-duvar-resmi/, /trafo-boyama/ ...).
// Google Ads reklamları ana sayfa yerine bu sayfalara yönlendirilmek üzere
// kurgulandı: sayfa başına tek konu, gerçek işler, SSS ve güçlü teklif çağrısı.
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import SprayStroke from "../components/SprayStroke.astro";
import SpraySplat from "../components/SpraySplat.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { gallery } from "../data/gallery";
import { serviceLandings, type ServiceLanding } from "../data/serviceLandings";

export function getStaticPaths() {
  return serviceLandings.map((s) => ({ params: { hizmet: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: ServiceLanding };

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/*.{png,jpeg,jpg}",
  { eager: true }
);
const getImg = (file: string): ImageMetadata => {
  const mod = allImages[`/src/assets/images/${file}`];
  if (!mod) throw new Error(`Hizmet sayfası görseli bulunamadı: ${file}`);
  return mod.default;
};

// Yalnız galeride kayıtlı gerçek işler; başlık ve alt metin oradan gelir
const works = s.works.map((file) => {
  const item = gallery.find((g) => g.src === file);
  if (!item) throw new Error(`${s.slug}: galeride olmayan iş görseli: ${file}`);
  return { ...item, meta: getImg(file) };
});

const isPricing = s.slug === "duvar-resmi-fiyatlari";
const others = serviceLandings.filter((o) => o.slug !== s.slug);
const pageUrl = new URL(`/${s.slug}/`, Astro.site).toString();
const waHref = `https://wa.me/905396183767?text=${encodeURIComponent(s.whatsappText)}`;

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${pageUrl}#service`,
      name: s.h1,
      description: s.description,
      url: pageUrl,
      areaServed: { "@type": "Country", name: "Türkiye" },
      provider: { "@id": new URL("/#business", Astro.site).toString() },
    },
    {
      "@type": "FAQPage",
      mainEntity: s.faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
});
---

<Layout title={s.title} description={s.description} image={`/images/${s.heroImage}`}>
  <script type="application/ld+json" set:html={schema} slot="head" />

  <div data-service={s.slug}>
    <PageHero label={s.label} title={s.h1} watermark={s.watermark} image={getImg(s.heroImage)}>
      <p class="max-w-2xl text-lg text-neutral-300 drop-shadow">{s.lead}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="foto_olcu_gonder"
          class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-accent/30 transition-colors hover:bg-accent-bright"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.668-.961z"/></svg>
          Fotoğraf/ölçü gönder, teklif al
        </a>
        <a
          href="tel:+905396183767"
          class="rounded-full border border-white/40 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10"
        >
          Ara: 0539 618 37 67
        </a>
      </div>
    </PageHero>

    <!-- Tanıtım + uygulama alanları -->
    <section class="relative overflow-hidden py-16 md:py-20">
      <div class="float-slower absolute right-[4%] top-[8%] hidden lg:block" aria-hidden="true">
        <SpraySplat class="h-10 w-10 rotate-12 text-spray-cyan/40" />
      </div>
      <div class="mx-auto grid max-w-6xl gap-12 px-5 md:grid-cols-2 md:gap-16">
        <div data-reveal>
          <h2 class="font-display text-3xl text-neutral-900 md:text-4xl">{s.introTitle}</h2>
          <SprayStroke class="mt-3 text-accent" />
          {s.intro.map((p) => <p class="mt-5 leading-relaxed text-neutral-600">{p}</p>)}
        </div>
        <div class="reveal-delay-1" data-reveal>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-neutral-500">{s.pointsTitle}</h2>
          <ul class="mt-5 space-y-3">
            {s.points.map((p) => (
              <li class="flex gap-4 rounded-2xl border border-neutral-200 p-5 transition-colors hover:border-accent/50">
                <span class="mt-1.5 h-2 w-2 flex-shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                <div>
                  <h3 class="font-bold text-neutral-900">{p.t}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-neutral-600">{p.d}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Gerçek işler -->
    <section class="border-t border-neutral-200 bg-neutral-50 py-16 md:py-20">
      <div class="mx-auto max-w-6xl px-5">
        <div class="mb-10 flex items-end justify-between gap-4" data-reveal>
          <div>
            <h2 class="font-display text-3xl text-neutral-900 md:text-4xl">{s.worksTitle}</h2>
            <SprayStroke class="mt-3 text-accent" />
          </div>
          <a href="/galeri/" class="hidden text-sm font-semibold text-neutral-600 transition-colors hover:text-accent md:block">Tüm galeri →</a>
        </div>
        <div class="grid grid-cols-2 gap-3 md:grid-cols-3">
          {works.map((w, i) => (
            <figure class:list={["group overflow-hidden rounded-xl bg-white ring-1 ring-neutral-200", i % 3 > 0 && `reveal-delay-${i % 3}`]} data-reveal>
              <div class="aspect-[4/3] overflow-hidden bg-neutral-200">
                <Image
                  src={w.meta}
                  alt={w.alt}
                  width={700}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  data-fade
                />
              </div>
              <figcaption class="px-3 py-2.5 text-sm font-semibold text-neutral-800">{w.title}</figcaption>
            </figure>
          ))}
        </div>
        <div class="mt-8 text-center md:hidden">
          <a href="/galeri/" class="inline-block rounded-full border border-neutral-300 px-6 py-2.5 text-sm font-semibold text-neutral-700 transition-colors hover:border-accent hover:text-accent">
            Tüm galeriyi gör →
          </a>
        </div>
      </div>
    </section>

    <!-- Süreç -->
    <section class="relative overflow-hidden bg-neutral-950 py-20 text-white">
      <div class="grain" aria-hidden="true"></div>
      <span
        aria-hidden="true"
        class="text-outline text-outline-dark pointer-events-none absolute -bottom-8 left-0 select-none whitespace-nowrap font-display text-[18vw] leading-none"
      >SÜREÇ</span>
      <div class="relative mx-auto max-w-6xl px-5">
        <div data-reveal>
          <h2 class="font-display text-3xl md:text-5xl">{s.processTitle ?? "Nasıl Çalışıyoruz"}</h2>
          <SprayStroke class="mt-3 text-accent-bright" />
        </div>
        <ol class="mt-12 grid gap-8 md:grid-cols-4">
          {s.process.map((p, i) => (
            <li class:list={["border-t border-neutral-800 pt-5 transition-colors hover:border-accent-bright", i > 0 && `reveal-delay-${i}`]} data-reveal>
              <p class="font-display text-4xl text-accent-bright">0{i + 1}</p>
              <h3 class="mt-3 text-lg font-bold">{p.t}</h3>
              <p class="mt-2 text-sm text-neutral-400">{p.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- SSS + Türkiye geneli -->
    <section class="py-16 md:py-20">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 md:grid-cols-[1fr_2fr]">
        <div data-reveal>
          <h2 class="font-display text-3xl text-neutral-900 md:text-4xl">Sık Sorulan Sorular</h2>
          <SprayStroke class="mt-3 text-accent" />
          <div class="mt-8 rounded-2xl bg-neutral-50 p-6 ring-1 ring-neutral-200">
            <p class="font-display text-xl text-neutral-900">Türkiye geneli hizmet</p>
            <p class="mt-2 text-sm leading-relaxed text-neutral-600">
              Türkiye'nin her yerinde proje yapıyoruz. İlk değerlendirmeyi
              gönderdiğiniz fotoğraf ve ölçüyle uzaktan yapıyor, gerektiğinde
              yerinde ücretsiz keşfe geliyoruz.
            </p>
          </div>
        </div>
        <div class="reveal-delay-1 space-y-3" data-reveal>
          {s.faq.map((f) => (
            <details class="group rounded-2xl border border-neutral-200 p-5 transition-colors open:border-accent/50">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold text-neutral-900 [&::-webkit-details-marker]:hidden">
                <h3>{f.q}</h3>
                <span class="mt-0.5 flex-shrink-0 text-xl leading-none text-accent transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-neutral-600">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Teklif çağrısı -->
    <section class="relative overflow-hidden bg-neutral-900 py-20 text-white">
      <div class="grain" aria-hidden="true"></div>
      <div class="float-slow absolute left-[7%] top-[16%] hidden md:block" aria-hidden="true">
        <SpraySplat class="h-12 w-12 -rotate-12 text-spray-cyan/40" />
      </div>
      <div class="relative mx-auto max-w-4xl px-5 text-center" data-reveal>
        <h2 class="font-display text-4xl md:text-5xl">Fotoğraf ve ölçü gönder, <span class="text-spray-gradient">teklif al</span></h2>
        <ol class="mx-auto mt-10 grid max-w-3xl gap-4 text-left sm:grid-cols-3">
          <li class="rounded-2xl bg-white/5 p-5 ring-1 ring-white/10">
            <span class="font-display text-2xl text-accent-bright">1</span>
            <p class="mt-1 text-sm text-neutral-300">Duvarın karşıdan bir fotoğrafını çekin.</p>
          </li>
          <li class="rounded-2xl bg-white/5 p-5 ring-1 ring-white/10">
            <span class="font-display text-2xl text-accent-bright">2</span>
            <p class="mt-1 text-sm text-neutral-300">Yaklaşık en ve yükseklik ölçüsünü not edin.</p>
          </li>
          <li class="rounded-2xl bg-white/5 p-5 ring-1 ring-white/10">
            <span class="font-display text-2xl text-accent-bright">3</span>
            <p class="mt-1 text-sm text-neutral-300">WhatsApp'tan gönderin, ücretsiz teklifinizi hazırlayalım.</p>
          </li>
        </ol>
        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            data-cta="foto_olcu_gonder"
            class="rounded-full bg-accent px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-accent/30 transition-colors hover:bg-accent-bright"
          >
            WhatsApp'tan gönder
          </a>
          <a href="/iletisim/" data-cta="teklif_al" class="rounded-full border border-white/40 px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10">
            İletişim formu
          </a>
          <a href="tel:+905396183767" class="rounded-full border border-white/40 px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10">
            0539 618 37 67
          </a>
        </div>
        {!isPricing && (
          <p class="mt-8 text-sm text-neutral-400">
            <a href="/duvar-resmi-fiyatlari/" class="font-semibold text-accent-soft underline decoration-accent-soft/40 underline-offset-4 hover:text-white">Fiyatı neler belirler?</a>
          </p>
        )}
      </div>
    </section>

    <!-- Diğer hizmet sayfaları (iç bağlantı) -->
    <section class="border-t border-neutral-200 py-12">
      <div class="mx-auto max-w-6xl px-5">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-neutral-500">Diğer hizmet alanlarımız</h2>
        <div class="mt-4 flex flex-wrap gap-2.5">
          {others.map((o) => (
            <a
              href={`/${o.slug}/`}
              class="rounded-full border border-neutral-300 px-4 py-2 text-sm font-semibold text-neutral-700 transition-colors hover:border-accent hover:text-accent"
            >
              {o.name}
            </a>
          ))}
          <a href="/hizmetler/" class="rounded-full border border-neutral-300 px-4 py-2 text-sm font-semibold text-neutral-700 transition-colors hover:border-accent hover:text-accent">
            Tüm hizmetler
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { track } from "../scripts/analytics";

  // Hizmet sayfası görüntülemesi: GA4'te hizmet bazında rapor ve key event için
  const service = document.querySelector<HTMLElement>("[data-service]")?.dataset.service;
  if (service) track("service_page_view", { service });
</script>
