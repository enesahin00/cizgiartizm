---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Kapak görselini optimize WebP olarak göster (og:image için string yol korunur).
const assetImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/*.{png,jpeg,jpg}",
  { eager: true }
);
const coverFile = post.data.image?.split("/").pop();
const cover = coverFile ? assetImages[`/src/assets/images/${coverFile}`]?.default : undefined;

const fmt = (d: Date) =>
  d.toLocaleDateString("tr-TR", { day: "numeric", month: "long", year: "numeric" });
---

<Layout title={`${post.data.title} — Çizgi Artizm`} description={post.data.description} image={post.data.image}>
  <article class="mx-auto max-w-3xl px-5 py-14">
    <a href="/blog" class="text-sm font-semibold text-neutral-500 hover:text-neutral-900">← Tüm yazılar</a>

    <header class="mt-6">
      <time class="text-xs font-semibold uppercase tracking-wider text-neutral-500">{fmt(post.data.date)}</time>
      <h1 class="mt-2 font-display text-3xl leading-tight text-neutral-900 md:text-5xl">{post.data.title}</h1>
      <p class="mt-4 text-lg text-neutral-600">{post.data.description}</p>
    </header>

    {cover && (
      <Image src={cover} alt={post.data.title} width={1200} height={675} class="mt-8 aspect-[16/9] w-full rounded-2xl object-cover" />
    )}

    <div class="prose prose-neutral mt-10 max-w-none prose-headings:font-bold prose-h2:mt-8 prose-h2:text-2xl prose-img:rounded-xl prose-a:text-neutral-900">
      <Content />
    </div>
  </article>
</Layout>
