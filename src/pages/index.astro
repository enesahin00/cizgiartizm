---
import Layout from "../layouts/Layout.astro";
import SprayStroke from "../components/SprayStroke.astro";
import SpraySplat from "../components/SpraySplat.astro";
import { Image, getImage } from "astro:assets";

import heroImg from "../assets/images/cizgi-sprey-kutu.png";
import svcZeus from "../assets/images/zeus-poseidon-bina-cephesi-grafitti.jpg";
import svcKadin from "../assets/images/renkli-kadin-portesi-grafitti.jpg";
import svcMickey from "../assets/images/mickey-mouse-minibus-airbrush.jpg";
import featKaplan from "../assets/images/beyaz-kaplan-duvar-resmi.jpg";
import featMelek from "../assets/images/melek-heykeli-ofis-duvar-resmi.jpg";
import featAtaturk from "../assets/images/ataturk-portresi-turk-bayragi-trafo-duvar-resmi.png";
import featEjderha from "../assets/images/ejderha-ic-mekan-duvar-resmi.jpg";
import featAraba from "../assets/images/sari-spor-araba-3kplus-duvar-resmi.jpg";
import refBuyuksehir from "../assets/images/referans-izmir-buyuksehir.png";
import refMetro from "../assets/images/referans-metro-izmir.png";
import refIzenerji from "../assets/images/referans-izenerji.png";
import refOsmanli from "../assets/images/referans-1453-osmanli.png";
import refCreative from "../assets/images/referans-creative-qp.png";
import refAltinordu from "../assets/images/referans-altinordu.png";
import type { ImageMetadata } from "astro";

const services: { title: string; desc: string; img: ImageMetadata }[] = [
  {
    title: "Graffiti & Duvar Resmi",
    desc: "Bina cepheleri, iç mekan duvarları, beton, ahşap ve metal yüzeylere hava koşullarına dayanıklı, uzun ömürlü graffiti uygulaması.",
    img: svcZeus,
  },
  {
    title: "Kişiye Özel Portre",
    desc: "Fotoğrafınızdan özgün portre çizimleri. Hediyelik ve koleksiyonluk eserler.",
    img: svcKadin,
  },
  {
    title: "Araç & Yat Airbrush",
    desc: "Otomobil, motosiklet, karavan ve teknelere airbrush tekniğiyle su geçirmez, özel tasarım uygulaması.",
    img: svcMickey,
  },
];

// 1 büyük + 4 küçük asimetrik grid; 2 ve 4 kolonda boşluksuz kapanır.
const featuredRaw: { img: ImageMetadata; alt: string; title: string }[] = [
  { img: featKaplan, alt: "Bina duvarına yapılmış gerçekçi beyaz kaplan graffitisi", title: "Beyaz Kaplan" },
  { img: featEjderha, alt: "İç mekan duvarına yapılmış ateşli ejderha duvar resmi", title: "Ejderha — İç Mekan" },
  { img: featMelek, alt: "Ofis duvarına yapılmış kanatlı melek heykeli temalı duvar resmi", title: "Melek Heykeli — Ofis" },
  { img: featAraba, alt: "İç mekanda duvardan fırlayan 3K PLUS plakalı sarı spor araba duvar resmi", title: "Sarı Spor Araba" },
  { img: featAtaturk, alt: "Kırmızı zeminde Türk bayrağı önünde siyah-beyaz Atatürk portresi trafo binası duvar resmi", title: "Atatürk Portresi — Trafo" },
];

// Büyütme (lightbox) için optimize, hash'li WebP — orijinal yerine.
const featured = await Promise.all(
  featuredRaw.map(async (f) => ({
    ...f,
    full: (await getImage({ src: f.img, width: 1400, format: "webp", quality: 78 })).src,
  }))
);

const steps = [
  { n: "01", t: "Danışmanlık & Planlama", d: "Mekanı, hayalinizi ve bütçeyi birlikte değerlendiriyoruz." },
  { n: "02", t: "Tasarım Geliştirme", d: "Size özel taslakları hazırlayıp onayınızı alıyoruz." },
  { n: "03", t: "Uygulama & Teslim", d: "Profesyonel ekip ve dayanıklı malzemelerle hayata geçiriyoruz." },
  { n: "04", t: "Son Değerlendirme", d: "Birlikte gözden geçirip işi eksiksiz teslim ediyoruz." },
];

const refs: { name: string; logo: ImageMetadata }[] = [
  { name: "İzmir Büyükşehir Belediyesi", logo: refBuyuksehir },
  { name: "Metro İzmir", logo: refMetro },
  { name: "İZENERJİ", logo: refIzenerji },
  { name: "1453 Osmanlı", logo: refOsmanli },
  { name: "Creative QP", logo: refCreative },
  { name: "Altınordu", logo: refAltinordu },
];
---

<Layout>
  <!-- HERO (ÇİZGİ sprey kutusu arka planı) -->
  <section class="relative isolate overflow-hidden bg-neutral-950 text-white">
    <Image
      src={heroImg}
      alt="ÇİZGİ yazılı sprey boya kutusu"
      class="hero-zoom absolute inset-0 -z-10 h-full w-full object-cover object-[70%_center] md:object-center"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Metnin okunması için yalnızca soldan hafif degrade; sağda sprey kutusu net görünür -->
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-neutral-950/90 via-neutral-950/45 to-transparent"></div>

    <!-- Süzülen sprey sıçramaları -->
    <div class="float-slow absolute right-[6%] top-[14%] hidden md:block" aria-hidden="true">
      <SpraySplat class="h-16 w-16 rotate-12 text-spray-cyan/70" />
    </div>
    <div class="float-slower absolute bottom-[16%] right-[30%] hidden lg:block" aria-hidden="true">
      <SpraySplat class="h-10 w-10 -rotate-45 text-spray-yellow/60" />
    </div>
    <div class="float-slower absolute left-[4%] top-[12%]" aria-hidden="true">
      <SpraySplat class="h-8 w-8 rotate-90 text-accent-bright/50" />
    </div>

    <div class="mx-auto max-w-6xl px-5 py-28 md:py-44">
      <div class="max-w-xl">
        <p class="hero-rise mb-5 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-white/80">
          <span class="h-2 w-2 rounded-full bg-accent-bright motion-safe:animate-pulse" aria-hidden="true"></span>
          Türkiye geneli
        </p>
        <h1 class="font-display text-5xl leading-[1.1] drop-shadow-lg md:text-7xl">
          <span class="hero-rise rise-delay-1 block">Duvarları <span class="text-spray-gradient">Sanata</span></span>
          <span class="hero-rise rise-delay-2 block">Dönüştürüyoruz</span>
        </h1>
        <p class="hero-rise rise-delay-3 mt-6 max-w-md text-lg text-white/90 drop-shadow">
          Bina cephelerinden iç mekanlara, araçlardan portrelere — profesyonel
          graffiti, duvar resmi ve airbrush sanatı. Türkiye genelinde her ölçekte
          proje teslim ediyoruz.
        </p>
        <div class="hero-rise rise-delay-4 mt-9 flex flex-wrap gap-4">
          <a href="/iletisim" class="rounded-full bg-accent px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-accent/30 transition-colors hover:bg-accent-bright">
            Teklif Al
          </a>
          <a href="/galeri" class="rounded-full border border-white/40 px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10">
            İşlerimizi Gör
          </a>
        </div>
      </div>
    </div>

    <!-- Aşağı kaydır ipucu -->
    <div class="absolute bottom-5 left-1/2 -translate-x-1/2 text-white/60 motion-safe:animate-bounce" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </div>
  </section>

  <!-- HİZMETLER -->
  <section class="py-20">
    <div class="mx-auto max-w-6xl px-5">
      <div class="mb-12 flex items-end justify-between" data-reveal>
        <div class="relative">
          <div class="absolute -right-14 -top-4 hidden md:block" aria-hidden="true">
            <SpraySplat class="h-9 w-9 rotate-45 text-spray-purple/50" />
          </div>
          <h2 class="font-display text-3xl text-neutral-900 md:text-5xl">Ne Yapıyoruz</h2>
          <SprayStroke class="mt-3 text-accent" />
        </div>
        <a href="/hizmetler" class="hidden text-sm font-semibold text-neutral-600 transition-colors hover:text-accent md:block">Tüm hizmetler →</a>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {services.map((s, i) => (
          <article
            class:list={[
              "group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-neutral-200 transition duration-300 hover:-translate-y-1.5 hover:-rotate-1 hover:shadow-xl hover:ring-accent/40",
              i > 0 && `reveal-delay-${i}`,
            ]}
            data-reveal
          >
            <div class="aspect-[4/3] overflow-hidden">
              <Image src={s.img} alt={s.title} width={800} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" data-fade />
            </div>
            <div class="p-6">
              <h3 class="text-lg font-bold text-neutral-900">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-600">{s.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ÖNE ÇIKAN İŞLER -->
  <section class="relative overflow-hidden border-t border-neutral-200 bg-neutral-50 py-20">
    <span
      aria-hidden="true"
      class="text-outline pointer-events-none absolute -top-4 right-0 select-none whitespace-nowrap font-display text-[16vw] leading-none"
    >PORTFÖY</span>
    <div class="relative mx-auto max-w-6xl px-5">
      <div class="mb-12 flex items-end justify-between" data-reveal>
        <div>
          <h2 class="font-display text-3xl text-neutral-900 md:text-5xl">Öne Çıkan İşler</h2>
          <SprayStroke class="mt-3 text-accent" />
        </div>
        <a href="/galeri" class="hidden text-sm font-semibold text-neutral-600 transition-colors hover:text-accent md:block">Tüm galeri →</a>
      </div>
      <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
        {featured.map((f, i) => (
          <button
            type="button"
            class:list={[
              "feat-item group relative aspect-square cursor-zoom-in overflow-hidden rounded-xl bg-neutral-200",
              i === 0 && "col-span-2 row-span-2",
              i > 0 && `reveal-delay-${i}`,
            ]}
            data-full={f.full}
            data-alt={f.alt}
            data-reveal
          >
            <Image
              src={f.img}
              alt={f.alt}
              width={i === 0 ? 1200 : 700}
              height={i === 0 ? 1200 : 700}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
              data-fade
            />
            <!-- Başlık: hover beklemeden, telefonda da görünür -->
            <div class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 via-black/25 to-transparent px-4 pb-3 pt-10 text-left">
              <p class="text-sm font-semibold text-white drop-shadow md:text-base">{f.title}</p>
            </div>
          </button>
        ))}
      </div>
      <div class="mt-8 text-center md:hidden" data-reveal>
        <a href="/galeri" class="inline-block rounded-full border border-neutral-300 px-6 py-2.5 text-sm font-semibold text-neutral-700 transition-colors hover:border-accent hover:text-accent">
          Tüm galeriyi gör →
        </a>
      </div>
    </div>
  </section>

  <!-- SÜREÇ -->
  <section class="relative overflow-hidden bg-neutral-950 py-20 text-white">
    <div class="grain" aria-hidden="true"></div>
    <span
      aria-hidden="true"
      class="text-outline text-outline-dark pointer-events-none absolute -bottom-8 left-0 select-none whitespace-nowrap font-display text-[18vw] leading-none"
    >SÜREÇ</span>
    <div class="relative mx-auto max-w-6xl px-5">
      <div data-reveal>
        <h2 class="font-display text-3xl md:text-5xl">Nasıl Çalışıyoruz</h2>
        <SprayStroke class="mt-3 text-accent-bright" />
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-4">
        {steps.map((s, i) => (
          <div class:list={["group border-t border-neutral-800 pt-5 transition-colors hover:border-accent-bright", i > 0 && `reveal-delay-${i}`]} data-reveal>
            <p class="font-display text-4xl text-accent-bright">{s.n}</p>
            <h3 class="mt-3 text-lg font-bold">{s.t}</h3>
            <p class="mt-2 text-sm text-neutral-400">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- REFERANSLAR (akan logo şeridi) -->
  <section class="py-20">
    <div class="mx-auto max-w-6xl px-5 text-center" data-reveal>
      <h2 class="font-display text-3xl text-neutral-900 md:text-5xl">Referanslarımız</h2>
      <SprayStroke class="mx-auto mt-3 text-accent" />
    </div>
    <div class="marquee relative mt-12 overflow-hidden" data-reveal>
      <div class="marquee-track flex w-max">
        {[false, true].map((hidden) => (
          <div class="flex shrink-0 items-center gap-14 pr-14 md:gap-20 md:pr-20" aria-hidden={hidden || undefined}>
            {refs.map((r) => (
              <Image
                src={r.logo}
                alt={hidden ? "" : r.name}
                role={hidden ? "presentation" : undefined}
                title={r.name}
                loading="lazy"
                class="max-h-14 w-auto shrink-0 object-contain opacity-80 transition-opacity duration-300 hover:opacity-100"
              />
            ))}
          </div>
        ))}
      </div>
      <!-- Kenar yumuşatma -->
      <div class="pointer-events-none absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-white to-transparent md:w-28" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 w-16 bg-gradient-to-l from-white to-transparent md:w-28" aria-hidden="true"></div>
    </div>
  </section>

  <!-- SEO / TANITIM METNİ -->
  <section class="border-t border-neutral-200 bg-neutral-50 py-16">
    <div class="mx-auto max-w-6xl px-5">
      <div class="grid gap-10 md:grid-cols-2 md:gap-16" data-reveal>
        <div>
          <h2 class="font-display text-2xl text-neutral-900 md:text-4xl">Türkiye Genelinde Graffiti & Duvar Resmi Sanatı</h2>
          <SprayStroke class="mt-3 text-accent" />
          <p class="mt-5 leading-relaxed text-neutral-600">
            Çizgi Artizm, profesyonel bir graffiti ve duvar resmi
            ekibidir. Bina cepheleri, ofis ve kafe iç mekanları, trafo binaları,
            su depoları, okul ve AVM duvarları — her ölçekteki yüzeyi özgün
            tasarımlarla sanata dönüştürüyoruz.
            Türkiye'nin her yerinde <a href="/hizmetler" class="font-semibold text-accent hover:text-accent-bright">duvar resmi, portre çizim ve airbrush</a>
            projeleri gerçekleştiriyoruz.
          </p>
        </div>
        <div class="md:pt-14">
          <p class="leading-relaxed text-neutral-600">
            Her projede UV ve hava koşullarına dayanıklı boyalar kullanıyor;
            vinç, iskele ve yüksekte çalışma dahil uygulamanın tamamını kendi
            ekibimizle yürütüyoruz. Çalışmalarımız metrekare bazlı, şeffaf
            fiyatlandırılır ve her proje <a href="/iletisim" class="font-semibold text-accent hover:text-accent-bright">ücretsiz keşif ve fiyat teklifiyle</a> başlar.
            İzmir Büyükşehir Belediyesi ve Metro İzmir gibi kurumlar için
            tamamladığımız işleri <a href="/galeri" class="font-semibold text-accent hover:text-accent-bright">galerimizde</a> inceleyebilir,
            sektöre dair yazılarımızı <a href="/blog" class="font-semibold text-accent hover:text-accent-bright">blogumuzda</a> okuyabilirsiniz.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative overflow-hidden bg-neutral-900 py-20 text-center text-white">
    <div class="grain" aria-hidden="true"></div>
    <span
      aria-hidden="true"
      class="text-outline text-outline-dark pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 select-none whitespace-nowrap font-display text-[20vw] leading-none"
    >ÇİZGİ</span>
    <div class="float-slow absolute left-[8%] top-[18%]" aria-hidden="true">
      <SpraySplat class="h-12 w-12 -rotate-12 text-spray-cyan/40" />
    </div>
    <div class="float-slower absolute bottom-[14%] right-[9%]" aria-hidden="true">
      <SpraySplat class="h-14 w-14 rotate-45 text-spray-yellow/35" />
    </div>
    <div class="relative mx-auto max-w-3xl px-5" data-reveal>
      <h2 class="font-display text-4xl md:text-6xl">Bir <span class="text-spray-gradient">fikrin</span> mi var?</h2>
      <p class="mt-5 text-lg text-neutral-300">Mekanını sanata çevirmek için bizimle iletişime geç. Ücretsiz keşif ve fiyat teklifi.</p>
      <a href="/iletisim" class="mt-8 inline-block rounded-full bg-accent px-8 py-3 text-sm font-semibold text-white shadow-lg shadow-accent/30 transition-colors hover:bg-accent-bright">
        Hemen İletişime Geç
      </a>
    </div>
  </section>

  <!-- Öne çıkan işler lightbox -->
  <div
    id="feat-lightbox"
    class="lightbox fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Görüntü görüntüleyici"
  >
    <button id="feat-close" aria-label="Kapat" class="absolute right-4 top-4 p-2 text-white/80 hover:text-white">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <img id="feat-img" src="" alt="" class="mx-auto max-h-[85vh] w-auto rounded-lg object-contain" />
  </div>
</Layout>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>(".feat-item"));
  const lightbox = document.getElementById("feat-lightbox")!;
  const lbImg = document.getElementById("feat-img") as HTMLImageElement;
  const lbClose = document.getElementById("feat-close") as HTMLButtonElement;
  let lastTrigger: HTMLElement | null = null;

  function open(btn: HTMLElement) {
    lastTrigger = btn;
    lbImg.src = btn.dataset.full ?? "";
    lbImg.alt = btn.dataset.alt ?? "";
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";
    lbClose.focus();
  }

  function close() {
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.style.overflow = "";
    lastTrigger?.focus();
  }

  items.forEach((el) => el.addEventListener("click", () => open(el)));
  lbClose.addEventListener("click", close);
  lightbox.addEventListener("click", (e) => {
    if (e.target === lightbox) close();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !lightbox.classList.contains("hidden")) close();
  });
</script>
