const contacts = [
  {
    label: content.phone,
    value: t.phones[0],
    href: "tel:+905396183767",
    icon: "phone",
    dir: "ltr",
  },
  {
    label: content.phone,
    value: t.phones[1],
    href: "tel:+905357746012",
    icon: "phone",
    dir: "ltr",
  },
  {
    label: content.whatsappLabel,
    value: content.whatsappValue,
    href: "https://wa.me/905396183767",
    icon: "whatsapp",
  },
  {
    label: content.email,
    value: "cizgiartizm@gmail.com",
    href: "mailto:cizgiartizm@gmail.com",
    icon: "mail",
    dir: "ltr",
  },
  {
    label: content.instagramLabel,
    value: "@cizgiartizm",
    href: "https://instagram.com/cizgiartizm",
    icon: "instagram",
    dir: "ltr",
