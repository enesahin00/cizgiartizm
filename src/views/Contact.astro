---

<Layout lang={lang} route="contact" title={content.metaTitle} description={content.metaDescription}>
  <PageHero label={content.label} title={content.title} watermark={content.watermark} image={headerBg}>
    <p class="max-w-xl text-lg text-neutral-300 drop-shadow">
      {content.intro}
    </p>
  </PageHero>

  <section class="relative overflow-hidden py-16">
    <div class="float-slower absolute right-[4%] top-[6%] hidden lg:block" aria-hidden="true">
      <SpraySplat class="h-11 w-11 rotate-12 text-spray-cyan/40" />
    </div>
    <div class="mx-auto grid max-w-6xl gap-12 px-5 lg:grid-cols-2">
      <!-- İletişim yöntemleri -->
      <div data-reveal>
        <h2 class="font-display text-2xl text-neutral-900">{content.reachTitle}</h2>
        <p class="mt-2 text-neutral-600">{content.reachText}</p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {contacts.map((c, i) => (
            <a
              href={c.href}
              class:list={[
                "group flex items-center gap-4 rounded-2xl border border-neutral-200 p-5 transition-colors hover:border-accent",
                contacts.length % 2 !== 0 && i === contacts.length - 1
                  ? "sm:col-span-2 sm:max-w-[calc(50%-8px)]"
                  : "",
              ]}
            >
              <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-neutral-900 text-white transition group-hover:scale-105 group-hover:bg-accent">
                {c.icon === "phone" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                )}
                {c.icon === "whatsapp" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.668-.961zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                )}
                {c.icon === "mail" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
                )}
                {c.icon === "instagram" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                )}
              </span>
              <span class="min-w-0">
                <span class="block text-xs font-semibold uppercase tracking-wider text-neutral-500">{c.label}</span>
                <span class="block truncate font-semibold text-neutral-900"><span dir={c.dir}>{c.value}</span></span>
              </span>
            </a>
          ))}
        </div>

        <p class="mt-8 text-sm text-neutral-500">
          <span class="font-semibold text-neutral-700">{content.areaLabel}</span>
          {content.area}
        </p>
      </div>

      <!-- Form -->
      <div class="reveal-delay-1 relative rounded-3xl bg-neutral-50 p-8 ring-1 ring-neutral-200" data-reveal>
        <div class="absolute -right-3 -top-3" aria-hidden="true">
          <SpraySplat class="h-10 w-10 rotate-45 text-accent/60" />
        </div>
        <h2 class="font-display text-2xl text-neutral-900">{content.formTitle}</h2>
        <p class="mt-2 text-sm text-neutral-600">
          {content.formText}
        </p>

        <!-- Durum mesajları script'e data-* ile gelir (CSP: inline değişken yok) -->
        <form
          id="contact-form"
          class="mt-6 space-y-4"
          data-sending={content.sending}
          data-success={content.success}
          data-failed={content.failed}
          data-network-error={content.networkError}
          data-fallback-before={content.fallbackBefore}
          data-fallback-link={content.fallbackLink}
          data-fallback-after={content.fallbackAfter}
        >
          <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
          <input type="hidden" name="subject" value={content.subject} />
          <input type="hidden" name="from_name" value="Çizgi Artizm Web Sitesi" />
          <!-- spam tuzağı: insanlar görmez, botlar doldurursa mesaj reddedilir.
               display:none zaten odak/erişilebilirlik ağacından çıkarır; aria-label denetçiler için. -->
          <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" class="hidden" aria-label={content.botcheck} />
          <div>
            <label for="ad" class="block text-sm font-medium text-neutral-700">{content.name}</label>
            <input id="ad" name="Ad Soyad" type="text" required class="mt-1 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/15" />
          </div>
          <div>
            <label for="eposta" class="block text-sm font-medium text-neutral-700">{content.email}</label>
            <input id="eposta" name="E-posta" type="email" dir="ltr" required class="mt-1 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/15" />
          </div>
          <div>
            <label for="mesaj" class="block text-sm font-medium text-neutral-700">{content.message}</label>
            <textarea id="mesaj" name="Mesaj" rows="4" required class="mt-1 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/15"></textarea>
          </div>
          <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-full bg-accent px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-accent/25 transition-colors hover:bg-accent-bright disabled:cursor-not-allowed disabled:opacity-60">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
            {content.send}
          </button>
          <p id="form-status" role="status" aria-live="polite" class="text-sm"></p>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const statusEl = document.getElementById("form-status");
  const msg = form?.dataset ?? {};

  // Hata mesajı + WhatsApp yönlendirmesi; metinler data-* içinden, DOM ile kurulur.
  function showError(text: string | undefined) {
    if (!statusEl) return;
    const link = document.createElement("a");
    link.className = "font-semibold underline";
    link.href = "https://wa.me/905396183767";
    link.target = "_blank";
    link.rel = "noopener";
    link.textContent = msg.fallbackLink ?? "WhatsApp";
    statusEl.replaceChildren(`${text} ${msg.fallbackBefore} `, link, ` ${msg.fallbackAfter}`);
    statusEl.className = "text-sm font-medium text-red-700";
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!statusEl) return;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    statusEl.textContent = msg.sending ?? "";
    statusEl.className = "text-sm text-neutral-600";
    btn?.setAttribute("disabled", "true");

    try {
      const res = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(form),
      });
      const data = await res.json();

      if (res.ok && data.success) {
        form.reset();
        // GA4 potansiyel müşteri olayı; Google Ads'e dönüşüm olarak aktarılabilir
        (window as any).gtag?.("event", "generate_lead", { form_id: "contact-form" });
        statusEl.textContent = msg.success ?? "";
        statusEl.className = "text-sm font-medium text-green-700";
      } else {
        showError(msg.failed);
      }
    } catch {
      showError(msg.networkError);
    } finally {
      btn?.removeAttribute("disabled");
    }
  });
</script>
