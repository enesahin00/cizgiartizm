      { title: "النمر الأبيض", alt: "جرافيتي واقعي لنمر أبيض على جدار مبنى" },
      { title: "التنين — مساحة داخلية", alt: "جدارية لتنين ينفث النار على جدار داخلي" },
      { title: "تمثال الملاك — مكتب", alt: "جدارية لتمثال ملاك مجنّح على جدار مكتب" },
      { title: "السيارة الرياضية الصفراء", alt: "جدارية داخلية لسيارة رياضية صفراء تحمل لوحة 3K PLUS وكأنها تخرج من الجدار" },
      { title: "بورتريه أتاتورك — مبنى محولات", alt: "بورتريه بالأبيض والأسود لأتاتورك أمام العلم التركي على خلفية حمراء، مرسوم على مبنى محولات كهربائية" },
