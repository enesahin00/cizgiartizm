---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { render, type CollectionEntry } from "astro:content";
import { routes, ui } from "../i18n";
import { getPosts, postAlternates, postHref, postLang, postPath } from "../i18n/blog";
import { getLandings, landingPath } from "../i18n/landings";

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const lang = postLang(post);
const { Content } = await render(post);

const content = {
  tr: {
    allPosts: "← Tüm yazılar",
    related: "İlgili Yazılar",
    caseStudy: "Vaka Çalışması",
    kunye: "Proje Künyesi",
    fields: { hizmet: "Hizmet", musteri: "Müşteri", konum: "Konum", yil: "Yıl", alan: "Alan", sure: "Süre" },
    serviceLink: "{name} hizmetimizi inceleyin →",
  },
  en: {
    allPosts: "← All articles",
    related: "Related Articles",
    caseStudy: "Case Study",
    kunye: "Project Details",
    fields: { hizmet: "Service", musteri: "Client", konum: "Location", yil: "Year", alan: "Area", sure: "Duration" },
    serviceLink: "See our {name} service →",
  },
  es: {
    allPosts: "← Todos los artículos",
    related: "Artículos relacionados",
    caseStudy: "Caso práctico",
    kunye: "Ficha del proyecto",
    fields: { hizmet: "Servicio", musteri: "Cliente", konum: "Ubicación", yil: "Año", alan: "Superficie", sure: "Duración" },
    serviceLink: "Ver el servicio: {name} →",
  },
  ar: {
    allPosts: "→ جميع المقالات",
    related: "مقالات ذات صلة",
    caseStudy: "دراسة حالة",
    kunye: "بطاقة المشروع",
    fields: { hizmet: "الخدمة", musteri: "العميل", konum: "الموقع", yil: "السنة", alan: "المساحة", sure: "المدة" },
    serviceLink: "تعرّف على خدمة {name} ←",
  },
}[lang];

// Kapak görselini optimize WebP olarak göster (og:image için string yol korunur).
const assetImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/*.{png,jpeg,jpg}",
  { eager: true }
);
const resolveImg = (path?: string): ImageMetadata | undefined => {
  if (!path) return undefined;
  const file = path.split("/").pop();
  return assetImages[`/src/assets/images/${file}`]?.default;
};
const cover = resolveImg(post.data.image);

// Vaka çalışması künyesi (frontmatter'da proje varsa). Hizmet satırı ve bağlantısı
// yazının dilindeki hizmet sayfasına gider.
const proje = post.data.proje;
const projeHizmet = proje ? getLandings(lang).find((l) => l.key === proje.hizmet) : undefined;
const f = content.fields;
const kunye = proje
  ? ([
      [f.hizmet, projeHizmet?.name],
      [f.musteri, proje.musteri],
      [f.konum, proje.konum],
      [f.yil, proje.yil?.toString()],
      [f.alan, proje.alan],
      [f.sure, proje.sure],
    ].filter(([, v]) => v) as [string, string][])
  : [];

// İlgili yazılar: her yazıya en az 2-3 iç link kazandırır (öksüz sayfa kalmaz).
const related = (await getPosts(lang)).filter((p) => p.id !== post.id).slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString(ui[lang].dateLocale, { day: "numeric", month: "long", year: "numeric" });

const blogPostingSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  image: post.data.image ? new URL(post.data.image, Astro.site).toString() : undefined,
  inLanguage: lang,
  author: { "@type": "Organization", name: "Çizgi Artizm", url: new URL(routes.home[lang], Astro.site).toString() },
  publisher: {
    "@type": "Organization",
    name: "Çizgi Artizm",
    logo: { "@type": "ImageObject", url: new URL("/favicon.svg", Astro.site).toString() },
  },
  mainEntityOfPage: new URL(postPath(post), Astro.site).toString(),
});
---

<Layout
  lang={lang}
  alternates={await postAlternates(post)}
  title={`${post.data.title} — Çizgi Artizm`}
  description={post.data.description}
  image={post.data.image}
>
  <script type="application/ld+json" set:html={blogPostingSchema} slot="head" />
  <article class="mx-auto max-w-3xl px-5 py-14">
    <a href={routes.blog[lang]} class="text-sm font-semibold text-neutral-500 transition-colors hover:text-accent">{content.allPosts}</a>

    <header class="mt-6">
      <time class="inline-block -rotate-1 bg-accent px-2.5 py-1 font-display text-xs tracking-wide text-white">{fmt(post.data.date)}</time>
      {proje && <span class="ms-2 inline-block rotate-1 bg-neutral-900 px-2.5 py-1 font-display text-xs tracking-wide text-white">{content.caseStudy}</span>}
      <h1 class="mt-4 font-display text-3xl leading-tight text-neutral-900 md:text-5xl">{post.data.title}</h1>
      <p class="mt-4 text-lg text-neutral-600">{post.data.description}</p>
    </header>

    {cover && (
      <div class="relative mt-10">
        <div class="absolute -inset-2 rotate-1 rounded-2xl bg-accent/10" aria-hidden="true"></div>
        <Image src={cover} alt={post.data.title} width={1200} height={675} class="relative aspect-[16/9] w-full rounded-2xl object-cover shadow-lg" />
      </div>
    )}

    {proje && (
      <aside class="mt-10 rounded-2xl bg-neutral-50 p-6 ring-1 ring-neutral-200">
        <p class="font-display text-lg text-neutral-900">{content.kunye}</p>
        <dl class="mt-4 grid gap-x-8 gap-y-3 text-sm sm:grid-cols-2">
          {kunye.map(([k, v]) => (
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wider text-neutral-500">{k}</dt>
              <dd class="mt-0.5 font-medium text-neutral-900">{v}</dd>
            </div>
          ))}
        </dl>
        {projeHizmet && (
          <a href={landingPath(projeHizmet)} class="mt-5 inline-block text-sm font-semibold text-accent transition-colors hover:text-accent-bright">
            {content.serviceLink.replace("{name}", projeHizmet.name)}
          </a>
        )}
      </aside>
    )}

    <div class="prose prose-neutral mt-10 max-w-none prose-headings:font-bold prose-h2:mt-8 prose-h2:text-2xl prose-img:rounded-xl prose-a:text-accent prose-a:decoration-accent/40 hover:prose-a:text-accent-bright">
      <Content />
    </div>

    {related.length > 0 && (
      <aside class="mt-14 border-t border-neutral-200 pt-10">
        <h2 class="font-display text-2xl text-neutral-900">{content.related}</h2>
        <ul class="mt-6 space-y-4">
          {related.map((p) => (
            <li>
              <a href={postHref(p)} class="group block">
                <span class="text-xs font-semibold uppercase tracking-wider text-accent">{fmt(p.data.date)}</span>
                <span class="mt-0.5 block font-semibold text-neutral-900 transition-colors group-hover:text-accent">{p.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </article>
</Layout>
