---
// Dil kutucukları: her biri aynı sayfanın o dildeki sürümüne gider.
// Mobilde logo + 4 kutu + menü 320px'e sığsın diye kutular küçük.
import { ui, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  links: Record<Lang, string>;
  class?: string;
}
const { lang, links, class: className } = Astro.props;

const order: Lang[] = ["en", "tr", "es", "ar"];
---

<div class:list={["flex items-center gap-1", className]} role="group" aria-label={ui[lang].langSwitch}>
  {order.map((l) => (
    <a
      href={links[l]}
      hreflang={l}
      lang={l}
      aria-current={l === lang ? "true" : undefined}
      class:list={[
        "flex h-7 w-7 items-center justify-center rounded-md border text-[11px] font-bold uppercase tracking-wide transition-colors md:h-8 md:w-9 md:text-xs",
        l === lang
          ? "border-neutral-900 bg-neutral-900 text-white"
          : "border-neutral-300 text-neutral-600 hover:border-accent hover:text-accent",
      ]}
    >
      {l}<span class="sr-only"> — {ui[l].langName}</span>
    </a>
  ))}
</div>
