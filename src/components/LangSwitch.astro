---
// Dil kutucukları: her biri aynı sayfanın o dildeki sürümüne gider. Kutuda dilin
// kendi yazısıyla kısaltması, altında bayrak. Bayraklar satır içi SVG: Windows
// bayrak emojisi çizmiyor (harf çifti gösteriyor). Bileşen header'da iki kez
// basıldığı için SVG'lerde id/clipPath yok.
// Mobilde logo + 4 kutu + menü 320px'e sığsın diye kutular küçük.
import { ui, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  links: Record<Lang, string>;
  class?: string;
}
const { lang, links, class: className } = Astro.props;

const order: Lang[] = ["en", "tr", "es", "ar"];

const labels: Record<Lang, string> = { en: "EN", tr: "TR", es: "ES", ar: "عربي" };
// TR bayrağı Wikimedia'daki resmi ölçülü çizimin koordinatlarında; EN 2:1, 3:2 kutuya kırpılır
const viewBoxes: Record<Lang, string> = { en: "0 0 60 30", tr: "0 -30000 90000 60000", es: "0 0 3 2", ar: "0 0 3 2" };
---

<div class:list={["lang-switch flex items-start gap-1", className]} role="group" aria-label={ui[lang].langSwitch}>
  {order.map((l) => (
    <a
      href={links[l]}
      hreflang={l}
      lang={l}
      aria-current={l === lang ? "true" : undefined}
      class="group flex flex-col items-center gap-0.5"
    >
      <span
        aria-hidden="true"
        class:list={[
          "flex h-7 min-w-7 items-center justify-center rounded-md border px-1 text-[11px] font-bold uppercase leading-none tracking-wide transition-colors md:min-w-9 md:text-xs",
          l === lang
            ? "border-neutral-900 bg-neutral-900 text-white"
            : "border-neutral-300 text-neutral-600 group-hover:border-accent group-hover:text-accent",
        ]}
      >
        {labels[l]}
      </span>
      {/* İngilizce: Birleşik Krallık; Arapça: BAE (sitenin Arapça kitlesi Dubai, og:locale ar_AE) */}
      <svg
        viewBox={viewBoxes[l]}
        preserveAspectRatio={l === "en" ? "xMidYMid slice" : undefined}
        class="h-[11px] w-4 rounded-[2px] ring-1 ring-black/10 md:h-3 md:w-[18px]"
        aria-hidden="true"
      >
        {l === "en" && (
          <>
            <rect width="60" height="30" fill="#012169" />
            <path d="M0 0l60 30M60 0L0 30" stroke="#fff" stroke-width="6" />
            <path d="M0 0l60 30M60 0L0 30" stroke="#C8102E" stroke-width="2" />
            <path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10" />
            <path d="M30 0v30M0 15h60" stroke="#C8102E" stroke-width="6" />
          </>
        )}
        {l === "tr" && (
          <>
            <path fill="#E30A17" d="m0-30000h90000v60000H0z" />
            <path
              fill="#fff"
              d="m41750 0 13568-4408-8386 11541V-7133l8386 11541zm925 8021a15000 15000 0 1 1 0-16042 12000 12000 0 1 0 0 16042z"
            />
          </>
        )}
        {l === "es" && (
          <>
            <rect width="3" height="2" fill="#AA151B" />
            <rect y="0.5" width="3" height="1" fill="#F1BF00" />
          </>
        )}
        {l === "ar" && (
          <>
            <rect width="3" height="2" fill="#00732F" />
            <rect y="0.667" width="3" height="0.667" fill="#fff" />
            <rect y="1.333" width="3" height="0.667" fill="#000" />
            <rect width="0.75" height="2" fill="#FF0000" />
          </>
        )}
      </svg>
      <span class="sr-only">{ui[l].langName}</span>
    </a>
  ))}
</div>
