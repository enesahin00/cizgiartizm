---
import LangSwitch from "./LangSwitch.astro";
import { navRoutes, routes, ui, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  langLinks: Record<Lang, string>;
}
const { lang, langLinks } = Astro.props;
const t = ui[lang];
const currentPath = Astro.url.pathname;

const links = navRoutes.map((key) => ({ href: routes[key][lang], label: t.nav[key] }));
const home = routes.home[lang];
const contact = routes.contact[lang];

const isActive = (href: string) =>
  href === home ? currentPath === home || currentPath === home.replace(/\/$/, "") : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-neutral-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-5 py-4 sm:gap-4">
    <!-- Mobilde dil seçimi logonun hemen sağında; masaüstünde menünün sonunda. 320px'te
         logo + bayraklı 4 kutu + menü sığsın diye: 360px altında logo bir kademe küçük
         (Arapça sayfada logo Cairo ile daha geniş), menü butonunun iç boşluğu kenara taşar. -->
    <div class="flex items-center gap-2 sm:gap-3">
      <a href={home} class="font-display text-lg tracking-tight text-neutral-900 min-[360px]:text-xl">
        ÇİZGİ<span class="text-accent">ARTİZM</span>
      </a>
      <LangSwitch lang={lang} links={langLinks} class="md:hidden" />
    </div>

    <nav class="hidden items-center gap-4 md:flex lg:gap-8">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            "whitespace-nowrap text-sm font-medium transition-colors",
            isActive(l.href)
              ? "text-neutral-900 font-semibold underline underline-offset-4 decoration-2 decoration-accent"
              : "text-neutral-600 hover:text-neutral-900",
          ]}
        >
          {l.label}
        </a>
      ))}
      <div class="flex items-center gap-2 lg:gap-3">
        <a
          href={contact}
          data-cta="teklif_al"
          class="whitespace-nowrap rounded-full bg-accent px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-accent-bright lg:px-5"
        >
          {t.quote}
        </a>
        <LangSwitch lang={lang} links={langLinks} />
      </div>
    </nav>

    <!-- Mobil menü -->
    <details id="mobile-menu" class="md:hidden">
      <summary class="-me-2 cursor-pointer list-none p-2 text-neutral-900" aria-label={t.menu}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </summary>
      <div class="absolute left-0 right-0 top-full border-b border-neutral-200 bg-white px-5 py-4 shadow-lg">
        {links.map((l) => (
          <a
            href={l.href}
            class:list={[
              "block py-2 text-base font-medium",
              isActive(l.href) ? "text-neutral-900 font-semibold" : "text-neutral-700",
            ]}
          >
            {l.label}
          </a>
        ))}
        <a href={contact} data-cta="teklif_al" class="mt-2 block rounded-full bg-accent px-5 py-2 text-center text-sm font-semibold text-white">{t.quote}</a>
      </div>
    </details>
  </div>
</header>

<script>
  const menu = document.getElementById("mobile-menu") as HTMLDetailsElement | null;
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => menu.removeAttribute("open"));
  });
</script>
