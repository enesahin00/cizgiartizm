---
import { navRoutes, routes, ui, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
---

<footer class="border-t border-neutral-800 bg-neutral-950 text-neutral-300">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-3">
    <div>
      <p class="font-display text-2xl text-white">ÇİZGİ<span class="text-accent-bright">ARTİZM</span></p>
      <p class="mt-3 max-w-xs text-sm text-neutral-400">
        {t.footer.tagline}
      </p>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-neutral-500">{t.footer.contact}</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li class="flex items-center gap-2">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 text-neutral-500"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <a href="tel:+905396183767" dir="ltr" class="hover:text-white">{t.phones[0]}</a>
        </li>
        <li class="flex items-center gap-2">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 text-neutral-500"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <a href="tel:+905357746012" dir="ltr" class="hover:text-white">{t.phones[1]}</a>
        </li>
        <li class="flex items-center gap-2">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 text-neutral-500"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
          <a href="mailto:cizgiartizm@gmail.com" class="hover:text-white">cizgiartizm@gmail.com</a>
        </li>
        <li class="flex items-center gap-2">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 text-neutral-500"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          <a href="https://instagram.com/cizgiartizm" dir="ltr" class="hover:text-white">@cizgiartizm</a>
        </li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-neutral-500">{t.footer.pages}</p>
      <ul class="mt-4 space-y-2 text-sm">
        {navRoutes.map((key) => (
          <li><a href={routes[key][lang]} class="hover:text-white">{t.nav[key]}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-neutral-800 px-5 py-5">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2">
      <p class="text-xs text-neutral-500">© {year} Çizgi Artizm. {t.footer.rights}</p>
      <a href={routes.privacy[lang]} class="text-xs text-neutral-500 hover:text-white">{t.footer.privacy}</a>
    </div>
  </div>
</footer>
